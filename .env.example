# PRD §24.2 Environment Variables
# Copy to .env and fill in values

# Server
SERVER_PORT=8080
APP_ENV=development
APP_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000

# Database (pgx/v5 — §18)
DATABASE_URL=postgres://pintour:pintour_pass@localhost:5432/pintour_db?sslmode=disable

# Redis (optional cache)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (§19.1: httpOnly cookie, §10.3: 8 jam)
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRATION_HOURS=8

# Fonnte WA Gateway (§16.1)
FONNTE_API_TOKEN= hocv48LGHZogixXTRjWw

# Resend Email (§16.3)
RESEND_API_KEY=
MAIL_FROM=noreply@pintour.app

# Supabase Storage (§16.2)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
