# PRD §24.2 Environment Variables
# Copy to .env and fill in values

# Server
SERVER_PORT=8080
# Hanya berlaku saat binary dijalankan langsung. Lewat docker compose nilainya
# ditentukan berkas compose — dasar memaksa production, docker-compose.dev.yml
# menurunkannya ke development — supaya deployment tidak pernah diam-diam
# berjalan sebagai development hanya karena baris ini ikut tersalin.
APP_ENV=development
APP_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000

# Domain publik server, dipakai Caddy untuk menerbitkan sertifikat (hanya
# docker-compose.prod.yml). Harus sudah menunjuk ke IP server sebelum deploy
# pertama — Let's Encrypt memverifikasinya dengan benar-benar menghubungi
# domain itu. Belum punya domain: 203-0-113-45.sslip.io, dengan angka IP server.
#
# Di produksi APP_URL dan PORTAL_BASE_URL harus https://<domain> yang sama.
# Keduanya masuk ke tautan yang dikirim ke peserta lewat WhatsApp dan email, dan
# Validate() menolak start bila masih menunjuk localhost.
SITE_DOMAIN=

# Token Cloudflare Tunnel (hanya docker-compose.tunnel.yml) — URL publik tanpa
# menyewa server. Diambil dari dash.cloudflare.com → Zero Trust → Networks →
# Tunnels. Ini rahasia: siapa pun yang memilikinya bisa menjalankan tunnel atas
# nama Anda.
TUNNEL_TOKEN=

# Database (pgx/v5 — §18)
DATABASE_URL=postgres://pintour:pintour_pass@localhost:5432/pintour_db?sslmode=disable

# Redis (optional cache)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (§19.1: httpOnly cookie, §10.3: 8 jam)
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRATION_HOURS=8

# Fonnte WA Gateway (§16.1)
FONNTE_API_TOKEN=

# Resend Email (§16.3)
RESEND_API_KEY=
MAIL_FROM=noreply@pintour.app

# Supabase Storage (§16.2)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── v2.0 features ────────────────────────────────────────────────────────────
# F1 Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox            # sandbox | production

# F2 Chatbot AI (Google Gemini)
GEMINI_API_KEY=
CHATBOT_MODEL=gemini-1.5-flash
CHATBOT_MAX_HISTORY=10
CHATBOT_ACTIVE=true
FONNTE_WEBHOOK_TOKEN=           # shared secret to authenticate Fonnte inbound webhook

# F6 OCR (self-hosted Tesseract — data dokumen tidak dikirim ke pihak ketiga)
OCR_ENGINE=tesseract_local      # tesseract_local | google_vision | none
TESSERACT_API_URL=http://tesseract-api:8884
GOOGLE_VISION_API_KEY=          # hanya jika OCR_ENGINE=google_vision
OCR_CONFIDENCE_THRESHOLD=0.85
OCR_TEMP_DIR=

# Frontend (web/.env): Snap.js URL for Midtrans
# VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# ── Kredensial infrastruktur (dibaca docker-compose.yml) ─────────────────────
# Compose memakai bentuk ${VAR:?...} untuk ketiganya: `docker compose up` akan
# BERHENTI dengan pesan bila kosong, bukan memakai nilai bawaan yang terbaca
# semua orang di repo publik. Terbitkan nilai baru untuk produksi — jangan
# memakai ulang yang pernah ada di riwayat git.
POSTGRES_DB=pintour_db
POSTGRES_USER=pintour
POSTGRES_PASSWORD=
# Port yang di-publish service web. Di produksi arahkan terminator TLS ke sini
# dan jangan buka 80 ke publik.
WEB_PORT=80

